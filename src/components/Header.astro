---
import { t, type Locale } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const p = (k: string) => t(lang, k);
const links = [
  { href: `/${lang}/`, label: p('nav_home') },
  { href: `/${lang}/what-is-955/`, label: p('nav_whatis') },
  { href: `/${lang}/8-hour-workday/`, label: p('nav_workday') },
  { href: `/${lang}/vacation-system/`, label: p('nav_vacation') },
  { href: `/${lang}/welfare-comparison/`, label: p('nav_welfare') },
  { href: `/${lang}/work-intensity/`, label: p('nav_intensity') },
  { href: `/${lang}/companies/`, label: p('nav_companies') },
  { href: `/${lang}/news/`, label: p('nav_news') },
  { href: `/${lang}/resources/`, label: p('nav_resources') },
];
---

<header class="sticky top-0 z-50 border-b" style="border-color: var(--line); background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(18px);">
  <nav class="mx-auto max-w-6xl px-4 h-16 flex items-center gap-6" aria-label="Main">
    <a href={`/${lang}/`} class="flex items-center gap-1.5 shrink-0 magnetic group" aria-label="955.life home">
      <span class="font-black text-[1.35rem] tracking-tight leading-none transition-opacity group-hover:opacity-75" style="color: var(--ink);">955<span class="text-gradient">.life</span></span>
    </a>

    <div class="hidden lg:flex items-center gap-1 flex-1">
      {
        links.map((l) => (
          <a href={l.href} class="px-3 py-2 rounded-full text-sm font-medium hover:opacity-80 transition-opacity" style="color: var(--ink-soft);">
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2 ml-auto">
      <ThemeToggle lang={lang} />
      <LangSwitch lang={lang} />
      <button id="menu-btn" class="lg:hidden w-10 h-10 grid place-items-center rounded-full border" style="border-color: var(--line);" aria-label={p('nav_menu')} aria-controls="mobile-menu" aria-expanded="false">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="lg:hidden hidden absolute top-[63px] left-0 right-0 px-4 pb-4" style="background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(18px); border-bottom: 1px solid var(--line);">
    <div class="flex flex-col gap-1 glass p-3">
      {links.map((l) => (<a href={l.href} class="px-3 py-2.5 rounded-xl text-sm font-medium" style="color: var(--ink-soft);">{l.label}</a>))}
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const menuLinks = menu.querySelectorAll('a');
    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
    }
    btn.addEventListener('click', function () {
      const open = menu.classList.contains('hidden');
      setOpen(open);
      if (open) {
        // 打开后焦点移入菜单首项
        const first = menuLinks[0];
        if (first) first.focus();
      } else {
        btn.focus();
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        btn.focus();
      }
    });
    menuLinks.forEach(function (l) {
      l.addEventListener('click', function () { setOpen(false); });
    });
  })();
</script>
