---
import { t, type Locale } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const p = (k: string) => t(lang, k);

/** 统一尾部斜杠，便于路径比较 */
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;

const homeHref = `/${lang}/`;

// 专题（文档页）——桌面端收进下拉，移动端平铺
const topicLinks = [
  { href: `/${lang}/what-is-955/`, label: p('nav_whatis') },
  { href: `/${lang}/8-hour-workday/`, label: p('nav_workday') },
  { href: `/${lang}/vacation-system/`, label: p('nav_vacation') },
  { href: `/${lang}/welfare-comparison/`, label: p('nav_welfare') },
  { href: `/${lang}/work-intensity/`, label: p('nav_intensity') },
  { href: `/${lang}/laws/`, label: p('nav_laws') },
];

// 顶部主导航：高频入口平铺
const mainLinks = [
  { href: homeHref, label: p('nav_home') },
  { href: `/${lang}/companies/`, label: p('nav_companies') },
  { href: `/${lang}/countdown/`, label: p('nav_cd') },
  { href: `/${lang}/news/`, label: p('nav_news') },
  { href: `/${lang}/resources/`, label: p('nav_resources') },
];

/**
 * 判断导航项是否为当前页。
 * 首页仅精确匹配；其余项支持前缀匹配（含子路径）。
 */
function isActive(href: string): boolean {
  if (href === homeHref) return pathname === homeHref;
  return pathname === href || pathname.startsWith(href);
}
const topicsActive = topicLinks.some((l) => isActive(l.href));
---

<header id="site-header" class="sticky top-0 z-50 border-b transition-shadow" style="border-color: var(--line); background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(18px);">
  <nav class="mx-auto max-w-6xl px-4 h-16 flex items-center gap-5" aria-label="Main">
    <a href={homeHref} class="flex items-center gap-1.5 shrink-0 magnetic group" aria-label="955.life home">
      <span class="font-display font-black text-[1.4rem] tracking-tight leading-none transition-opacity group-hover:opacity-75" style="color: var(--ink);">955<span class="text-gradient">.life</span></span>
    </a>

    <div class="hidden lg:flex items-center gap-0.5 flex-1">
      {
        mainLinks.slice(0, 1).map((l) => (
          <a
            href={l.href}
            class:list={['nav-link px-3 py-2 rounded-lg text-sm font-medium transition-colors', isActive(l.href) && 'nav-link--active']}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }

      <!-- 专题下拉 -->
      <details class="relative" data-popover>
        <summary
          class:list={['nav-link flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer', topicsActive && 'nav-link--active']}
          aria-label={p('nav_topics')}
        >
          {p('nav_topics')}
          <svg class="pop-caret" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="pop-panel" style="left: 0; right: auto;">
          {
            topicLinks.map((l) => (
              <a
                href={l.href}
                class:list={['block px-3 py-2 rounded-lg text-sm transition-colors nav-link', isActive(l.href) && 'nav-link--active']}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            ))
          }
        </div>
      </details>

      {
        mainLinks.slice(1).map((l) => (
          <a
            href={l.href}
            class:list={['nav-link px-3 py-2 rounded-lg text-sm font-medium transition-colors', isActive(l.href) && 'nav-link--active']}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2 ml-auto">
      <ThemeToggle lang={lang} />
      <LangSwitch lang={lang} />
      <button id="menu-btn" class="lg:hidden w-10 h-10 grid place-items-center rounded-full border" style="border-color: var(--line);" aria-label={p('nav_menu')} aria-controls="mobile-menu" aria-expanded="false">
        <svg id="menu-icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg id="menu-icon-close" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="lg:hidden hidden absolute top-[63px] left-0 right-0 px-4 pb-4" style="background: color-mix(in srgb, var(--bg) 94%, transparent); backdrop-filter: blur(18px); border-bottom: 1px solid var(--line);">
    <div class="flex flex-col gap-1 glass p-3">
      {
        [...mainLinks.slice(0, 1), ...topicLinks, ...mainLinks.slice(1)].map((l) => {
          const active = isActive(l.href);
          return (
            <a
              href={l.href}
              class:list={[
                'nav-link px-3 py-2.5 rounded-xl text-sm font-medium transition-colors',
                active && 'nav-link--active',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {l.label}
            </a>
          );
        })
      }
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-btn');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('menu-icon-open');
    var iconClose = document.getElementById('menu-icon-close');
    var menuLinks = menu.querySelectorAll('a');
    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    }
    btn.addEventListener('click', function () {
      var open = menu.classList.contains('hidden');
      setOpen(open);
      if (open) {
        // 打开后焦点移入菜单首项
        var first = menuLinks[0];
        if (first) first.focus();
      } else {
        btn.focus();
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
        setOpen(false);
        btn.focus();
      }
    });
    menuLinks.forEach(function (l) {
      l.addEventListener('click', function () { setOpen(false); });
    });

    // 滚动后给 sticky 头部加阴影层次；只在跨越阈值时改 DOM，避免每帧触发样式重算
    var header = document.getElementById('site-header');
    var scrolled = null;
    function onScroll() {
      var next = window.scrollY > 8;
      if (next === scrolled) return;
      scrolled = next;
      header.classList.toggle('is-scrolled', next);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>
