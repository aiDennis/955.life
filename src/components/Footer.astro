---
import { t, type Locale } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const p = (k: string) => t(lang, k);
// 快速入口：顶部导航的补充，只留高频目标
const quickLinks = [
  { href: `/${lang}/companies/`, label: p('nav_companies') },
  { href: `/${lang}/news/`, label: p('nav_news') },
  { href: `/${lang}/resources/`, label: p('nav_resources') },
];
const external = [
  { href: 'https://github.com/996icu/996.ICU', label: '996.ICU' },
  { href: 'https://github.com/formulahendry/955.WLB', label: '955.WLB' },
  { href: 'https://github.com/formulahendry/944.Life', label: '944.Life' },
];
---

<footer class="mt-12 border-t" style="border-color: var(--line); background: var(--bg-soft);">
  <div class="mx-auto max-w-6xl px-4 py-8 flex flex-col gap-8 md:flex-row md:justify-between">
    <div>
      <div class="flex items-center gap-1.5 mb-2.5">
        <span class="font-black text-xl tracking-tight leading-none" style="color: var(--ink);">955<span class="text-gradient">.life</span></span>
      </div>
      <p class="text-sm leading-relaxed" style="color: var(--ink-soft);">{p('foot_about_d')}</p>
      <a href="https://github.com/aiDennis/955.life" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 text-xs font-semibold mt-3 hover:underline" style="color: var(--brand);">
        <Icon name="external" size={13} /> GitHub
      </a>
    </div>

    <!-- 快速入口 + 相关项目：移动端并排两列，桌面保持两栏靠右 -->
    <div class="grid grid-cols-2 gap-8 md:flex md:gap-16">
      <nav aria-label="Footer">
        <h3 class="text-sm font-bold mb-2.5">{p('foot_links')}</h3>
        <ul class="space-y-1.5">
          {quickLinks.map((l) => (
            <li><a href={l.href} class="text-sm hover:underline" style="color: var(--ink-soft);">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="text-sm font-bold mb-2.5">{p('foot_resources')}</h3>
        <ul class="space-y-1.5">
          {external.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener" class="text-sm hover:underline inline-flex items-center gap-1" style="color: var(--ink-soft);">{l.label} <Icon name="external" size={12} /></a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <div class="border-t" style="border-color: var(--line);">
    <div class="mx-auto max-w-6xl px-4 py-3 flex flex-col md:flex-row items-center justify-between gap-1.5 text-xs" style="color: var(--ink-soft); opacity: 0.75;">
      <p>{p('foot_rights')}</p>
      <div class="flex items-center gap-3">
        <a href="/sitemap.xml" class="hover:underline">{p('foot_sitemap')}</a>
        <p>{p('foot_legal')}</p>
      </div>
    </div>
  </div>
</footer>
