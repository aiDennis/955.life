---
import { laborStats } from '../data/labor-stats';
import { t, type Locale } from '../i18n/ui';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const p = (k: string) => t(lang, k);
const isZh = lang.startsWith('zh');
const units: Record<string, { h: string; d: string }> = {
  'zh-CN': { h: ' 小时', d: ' 天' },
  'zh-Hant': { h: ' 小時', d: ' 天' },
  en: { h: 'h', d: 'd' },
  ja: { h: '時間', d: '日' },
  ko: { h: '시간', d: '일' },
  de: { h: ' Std.', d: ' Tage' },
  es: { h: ' h', d: ' días' },
  fr: { h: ' h', d: ' j' },
};
const maxHours = Math.max(...laborStats.map((s) => s.hours));
const maxLeave = Math.max(...laborStats.map((s) => s.leave));
const maxActual = Math.max(...laborStats.map((s) => s.actual));
const maxDays = Math.max(maxLeave, maxActual); // 统一参考系
---

<section class="mx-auto max-w-6xl px-4 py-16" id="stats">
  <div class="text-center mb-10 reveal">
    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">{p('chart_t')}</h2>
    <p class="mt-2 text-sm" style="color: var(--ink-soft);">{p('chart_d')}</p>
  </div>

  <div class="glass p-6 md:p-8 reveal">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6 text-xs font-semibold">
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full" style="background: linear-gradient(90deg, #FDBA74, #FB923C);"></span>{p('chart_h')} <span class="font-normal opacity-60 tabular-nums">0–{maxHours}{units[lang].h}</span></span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full" style="background: #475569;"></span>{p('chart_l')} <span class="font-normal opacity-60 tabular-nums">0–{maxDays}{units[lang].d}</span></span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full" style="background: #0D9488;"></span>{p('chart_actual')} <span class="font-normal opacity-60 tabular-nums">0–{maxActual}{units[lang].d}</span></span>
    </div>

    <div class="space-y-1">
      {laborStats.map((s) => (
        <div class="chart-row grid items-center gap-x-2 rounded-xl px-2.5 py-1.5" style="grid-template-columns: 3.5rem minmax(0, 1fr);" title={isZh ? s.noteZh : s.noteEn}>
          <span class="text-xs font-medium truncate" style="color: var(--ink-soft);">{isZh ? s.nameZh : s.nameEn}</span>
          <div class="space-y-1.5 min-w-0">
            <div class="flex items-center gap-2">
              <div class="h-3 rounded-full overflow-hidden flex-1 min-w-0" style="background: var(--bg-soft); padding-right: 2px;">
                <div class="h-full rounded-full" style={`width: ${(s.hours / maxHours) * 100}%; background: linear-gradient(90deg, #FDBA74, #FB923C);`}></div>
              </div>
              <span class="text-[13px] font-bold whitespace-nowrap tabular-nums leading-none w-16 text-right shrink-0" style="color: var(--ink);">{s.hours}{units[lang].h}</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="h-3 rounded-full overflow-hidden flex-1 min-w-0" style="background: var(--bg-soft); padding-right: 2px;">
                <div class="h-full rounded-full" style={`width: ${(s.leave / maxDays) * 100}%; background: #475569;`}></div>
              </div>
              <span class="text-[13px] font-bold whitespace-nowrap tabular-nums leading-none w-16 text-right shrink-0" style="color: var(--ink);">{s.leave}{units[lang].d}</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="h-3 rounded-full overflow-hidden flex-1 min-w-0" style="background: var(--bg-soft); padding-right: 2px;">
                <div class="h-full rounded-full" style={`width: ${(s.actual / maxDays) * 100}%; background: #0D9488;`}></div>
              </div>
              <span class="text-[13px] font-bold whitespace-nowrap tabular-nums leading-none w-16 text-right shrink-0" style="color: var(--ink);">{s.actual}{units[lang].d}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <p class="mt-6 pt-4 text-xs border-t" style="color: var(--ink-soft); opacity: 0.8; border-color: var(--line);">
      {isZh
        ? '口径说明：法定带薪假 = 法定年假 + 法定公共节假日（中国 5 天年假起 + 11 天节假日 = 16 天起；英国 28 天已含公共假日；西班牙为日历日口径）。实际休假 = 实际休取的年假天数（不含公共假日），为 Expedia 调查、日本厚劳省、美国 BLS 等来源的近似值；韩国法定 30 天但实际年假只休约 7 天。悬停数据行可查看各国说明。'
        : 'Note: statutory leave = annual leave + public holidays (China: 5 days + 11 holidays = 16+; UK: 28 already includes holidays; Spain on calendar-day basis). Actual = annual leave actually taken (excl. holidays, approx. per Expedia/MHLW/US BLS); South Korea: 30 statutory but ~7 taken. Hover a row for country notes.'}
    </p>
  </div>
</section>

<style>
  .chart-row {
    transition: background-color 0.2s ease;
  }
  .chart-row:hover {
    background: color-mix(in srgb, var(--brand-glow) 55%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .chart-row { transition: none; }
  }
</style>
