---
import Base from '../../layouts/Base.astro';
import NewsList from '../../components/NewsList.astro';
import { locales, t, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Locale };
const p = (k: string) => t(lang, k);

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t(lang, 'news_t'),
    description: t(lang, 'news_d'),
    inLanguage: lang,
    url: `https://955.life/${lang}/news/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(lang, 'nav_home'), item: `https://955.life/${lang}/` },
      { '@type': 'ListItem', position: 2, name: t(lang, 'nav_news'), item: `https://955.life/${lang}/news/` },
    ],
  },
]);
---

<Base title={t(lang, 'seo_news_t')} description={t(lang, 'seo_news_d')} lang={lang} jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14">
    <div class="mb-8 reveal">
      <h1 class="text-3xl md:text-4xl font-black tracking-tight">{p('news_t')}</h1>
      <p class="mt-2 text-sm" style="color: var(--ink-soft);">{p('news_d')}</p>
    </div>
    <NewsList lang={lang} />
  </section>
</Base>
