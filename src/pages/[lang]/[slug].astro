---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n/ui';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => {
    const [lang, ...rest] = entry.id.split('/');
    return {
      params: { lang, slug: rest.join('/').replace(/\.md$/, '') },
      props: { entry, lang },
    };
  });
}

type DocEntry = CollectionEntry<'docs'>;
const { entry, lang } = Astro.props as { entry: DocEntry; lang: Locale };
const { Content } = await render(entry);
const p = (k: string) => t(lang, k);
const slugPath = entry.id.split('/').slice(1).join('/').replace(/\.md$/, '');
const canonical = `https://955.life/${lang}/${slugPath}/`;
const siteUrl = 'https://955.life/';

// ---- 相关阅读：标签 + 标题/描述关键词多维打分，2 或 4 条成对显示 ----
const allDocs = await getCollection('docs');
const sameLang = allDocs.filter((d) => d.id.startsWith(`${lang}/`));
// 阅读顺序（order）
const orderedDocs = [...sameLang].sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const myTags = new Set(entry.data.tags ?? []);

/** 提取关键词：中文/日文/韩文按 2-gram，其余按词 */
function keyTokens(s: string): Set<string> {
  const lower = s.toLowerCase();
  const cjk = lower.replace(/[^\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af]+/g, '');
  const out = new Set<string>();
  if (cjk.length > 1) {
    for (let i = 0; i < cjk.length - 1; i++) out.add(cjk.slice(i, i + 2));
  }
  for (const w of lower.replace(/[^a-z0-9]+/g, ' ').split(' ')) {
    if (w.length > 2) out.add(w);
  }
  return out;
}

const related = (() => {
  const curKeys = keyTokens(`${entry.data.title} ${entry.data.description}`);
  const scored = sameLang
    .filter((d) => d.id !== entry.id)
    .map((d) => {
      const tagHit = (d.data.tags ?? []).filter((x) => myTags.has(x)).length;
      const dKeys = keyTokens(`${d.data.title} ${d.data.description}`);
      let kwHit = 0;
      dKeys.forEach((k) => { if (curKeys.has(k)) kwHit++; });
      // 标签命中权重高，关键词重叠作区分度
      return { d, score: tagHit * 3 + kwHit };
    })
    .filter((x) => x.score > 0)
    .sort((a, b) => b.score - a.score || (a.d.data.order ?? 99) - (b.d.data.order ?? 99));
  const matched = scored.slice(0, 4).map((x) => x.d);
  // 两列布局：只显示 2 或 4 条；1/3 条时用阅读顺序最接近的文章补足
  if (matched.length === 0 || matched.length === 2) return matched;
  const target = matched.length === 1 ? 2 : 4;
  const picked = new Set(matched.map((d) => d.id));
  const myOrder = entry.data.order ?? 99;
  const neighbors = orderedDocs
    .filter((d) => d.id !== entry.id && !picked.has(d.id))
    .sort((a, b) => Math.abs((a.data.order ?? 99) - myOrder) - Math.abs((b.data.order ?? 99) - myOrder));
  return [...matched, ...neighbors].slice(0, target);
})();

// ---- 上一篇 / 下一篇：同语言内按阅读顺序（order）----
const idx = orderedDocs.findIndex((d) => d.id === entry.id);
const prevDoc = idx > 0 ? orderedDocs[idx - 1] : null;
const nextDoc = idx >= 0 && idx < orderedDocs.length - 1 ? orderedDocs[idx + 1] : null;
const relPath = (d: DocEntry) => d.id.split('/').slice(1).join('/').replace(/\.md$/, '');

// ---- Schema 组装（Article + FAQPage + BreadcrumbList）----
const schemas: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.date,
    dateModified: entry.data.updated ?? entry.data.date,
    inLanguage: lang,
    mainEntityOfPage: canonical,
    author: { '@type': 'Organization', name: '955.life', url: siteUrl },
    publisher: { '@type': 'Organization', name: '955.life', url: siteUrl, logo: { '@type': 'ImageObject', url: 'https://955.life/favicon.svg' } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: p('nav_home'), item: `${siteUrl}${lang}/` },
      { '@type': 'ListItem', position: 2, name: entry.data.title, item: canonical },
    ],
  },
];
if (entry.data.faq?.length) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: entry.data.faq.map((f: { q: string; a: string }) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
const jsonLd = JSON.stringify(schemas);
---

<Base title={`${entry.data.title} | 955.life`} description={entry.data.description} lang={lang} jsonLd={jsonLd}>
  <div id="read-progress" class="read-progress" aria-hidden="true"></div>
  <article class="mx-auto max-w-3xl px-4 pt-10 pb-12">
    <a href={`/${lang}/`} class="text-sm font-semibold hover:underline" style="color: var(--brand);">← {p('back')}</a>
    <h1 class="mt-4 text-3xl md:text-4xl font-black tracking-tight leading-tight">{entry.data.title}</h1>
    <p class="mt-3 text-base leading-relaxed" style="color: var(--ink-soft);">{entry.data.description}</p>
    <div class="mt-4 flex flex-wrap items-center gap-3 text-xs" style="color: var(--ink-soft);">
      <time class="font-semibold">{p('updated')} {entry.data.updated ?? entry.data.date}</time>
      {
        entry.data.tags?.map((tag: string) => (
          <span class="chip !cursor-default">{tag}</span>
        ))
      }
    </div>
    <hr class="my-8" style="border-color: var(--line);" />
    <div class="prose-doc text-[15px]">
      <Content />
    </div>

    {
      entry.data.faq?.length > 0 && (
        <>
          <hr class="my-10" style="border-color: var(--line);" />
          <h2 class="text-xl font-extrabold mb-5">{p('faq_t')}</h2>
          <div class="space-y-4">
            {
              entry.data.faq.map((f: { q: string; a: string }) => (
                <div class="glass p-5">
                  <h3 class="font-bold text-[15px] mb-2">{f.q}</h3>
                  <p class="text-sm leading-7" style="color: var(--ink-soft);">{f.a}</p>
                </div>
              ))
            }
          </div>
        </>
      )
    }

    {
      related.length > 0 && (
        <div class="mt-10 pt-8 border-t" style="border-color: var(--line);">
          <h2 class="text-lg font-extrabold mb-4">{p('related_t')}</h2>
          <div class="grid gap-3 sm:grid-cols-2">
            {
              related.map((r) => (
                <a href={`/${lang}/${relPath(r)}/`} class="glass p-4 hover:underline">
                  <p class="text-sm font-semibold" style="color: var(--ink);">{r.data.title}</p>
                  <p class="mt-1 text-xs leading-5" style="color: var(--ink-soft);">{r.data.description}</p>
                </a>
              ))
            }
          </div>
        </div>
      )
    }

    {
      (prevDoc || nextDoc) && (
        <nav class="mt-10 pt-6 border-t flex justify-between gap-4" style="border-color: var(--line);" aria-label={p('related_t')}>
          {
            prevDoc ? (
              <a href={`/${lang}/${relPath(prevDoc)}/`} class="flex-1 min-w-0">
                <p class="text-xs font-semibold" style="color: var(--ink-soft);">← {p('prev_t')}</p>
                <p class="mt-1 text-sm font-semibold truncate" style="color: var(--ink);">{prevDoc.data.title}</p>
              </a>
            ) : <span class="flex-1" />
          }
          {
            nextDoc ? (
              <a href={`/${lang}/${relPath(nextDoc)}/`} class="flex-1 min-w-0 text-right">
                <p class="text-xs font-semibold" style="color: var(--ink-soft);">{p('next_t')} →</p>
                <p class="mt-1 text-sm font-semibold truncate" style="color: var(--ink);">{nextDoc.data.title}</p>
              </a>
            ) : <span class="flex-1" />
          }
        </nav>
      )
    }
  </article>

  <script is:inline>
    // 阅读进度条：rAF 节流的滚动监听
    (function () {
      var bar = document.getElementById('read-progress');
      if (!bar) return;
      var ticking = false;
      function update() {
        var h = document.documentElement;
        var max = h.scrollHeight - h.clientHeight;
        bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
        ticking = false;
      }
      window.addEventListener('scroll', function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true });
      update();
    })();
  </script>
</Base>
