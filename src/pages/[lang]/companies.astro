---
import Base from '../../layouts/Base.astro';
import CompanyFilter from '../../components/CompanyFilter.astro';
import { locales, t, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Locale };
const p = (k: string) => t(lang, k);

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: t(lang, 'co_t'),
    description: t(lang, 'co_d'),
    inLanguage: lang,
    url: `https://955.life/${lang}/companies/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(lang, 'nav_home'), item: `https://955.life/${lang}/` },
      { '@type': 'ListItem', position: 2, name: t(lang, 'nav_companies'), item: `https://955.life/${lang}/companies/` },
    ],
  },
]);
---

<Base title={t(lang, 'seo_companies_t')} description={t(lang, 'seo_companies_d')} lang={lang} jsonLd={jsonLd}>
  <CompanyFilter lang={lang} />
</Base>
