---
import Base from '../../layouts/Base.astro';
import { locales, t, type Locale } from '../../i18n/ui';
import { countdowns, EU_FLR } from '../../data/countdowns';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Locale };
const p = (k: string) => t(lang, k);

/** 假期结束次日 00:00（北京时间）视为结束：end 日期 + 1 天 */
const endPlusOne = (iso: string) => new Date(`${iso}T00:00:00+08:00`).getTime() + 86400000;
const startTs = (iso: string) => new Date(`${iso}T00:00:00+08:00`).getTime();

const items = countdowns.map((c) => ({ ...c, startTs: startTs(c.start), endTs: endPlusOne(c.end) }));
const now = Date.now();
const euAppliesTs = startTs(EU_FLR.applies);
const euDays = Math.max(0, Math.ceil((euAppliesTs - now) / 86400000));

const jsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: t(lang, 'cd_t'),
    description: t(lang, 'seo_cd_d'),
    inLanguage: lang,
    url: `https://955.life/${lang}/countdown/`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(lang, 'nav_home'), item: `https://955.life/${lang}/` },
      { '@type': 'ListItem', position: 2, name: t(lang, 'nav_cd'), item: `https://955.life/${lang}/countdown/` },
    ],
  },
]);
---

<Base title={t(lang, 'seo_cd_t')} description={t(lang, 'seo_cd_d')} lang={lang} jsonLd={jsonLd}>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-14">
    <!-- 主卡：EU 禁强迫劳动条例正式适用倒计时 -->
    <div
      class="reveal relative mb-10 overflow-hidden rounded-2xl border px-6 py-14 md:px-12 md:py-16 text-center"
      style="border-color: color-mix(in srgb, var(--brand) 28%, var(--line)); background: var(--surface);"
      data-cd-hero
      data-start={euAppliesTs}
    >
      <div
        class="pointer-events-none absolute inset-0"
        style="background:
          radial-gradient(32rem 16rem at 50% -15%, color-mix(in srgb, var(--brand) 16%, transparent), transparent 65%),
          radial-gradient(20rem 14rem at 95% 110%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 55%);"
        aria-hidden="true"
      ></div>

      <p class="relative text-sm md:text-base leading-relaxed" style="color: var(--ink-soft);">
        {p('cd_eu_lead_pre') ? `${p('cd_eu_lead_pre')} ` : ''}
        <strong
          class="font-display mx-0.5 text-lg md:text-xl font-black"
          style="color: var(--ink);"
        >
          {p('cd_eu_label')}
        </strong>
        {p('cd_eu_lead_post') ? ` ${p('cd_eu_lead_post')}` : ''}
      </p>

      <div class="relative my-7 md:my-8 flex items-end justify-center gap-2">
        <span
          class="font-display text-6xl md:text-7xl font-black leading-none text-gradient tabular-nums tracking-tight"
          data-cd-num
        >{euDays}</span>
        <span class="text-lg md:text-xl font-semibold mb-1.5" style="color: var(--ink-soft);" data-cd-unit>
          {p('cd_days')}
        </span>
      </div>

      <p class="relative text-xs leading-relaxed" style="color: var(--ink-soft);">
        {p('cd_eu_sub')}<br />
        {p('cd_eu_sub2')}
      </p>
    </div>

    <div class="reveal mb-4">
      <h2 class="text-lg md:text-xl font-semibold tracking-tight" style="color: var(--ink);">{p('cd_eu_holidays_title')}</h2>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3 reveal">
      {items.map((i) => (
        <div
          class="rounded-2xl border px-5 py-4 flex flex-col gap-3"
          style="border-color: var(--line); background: var(--surface);"
          data-cd-item
          data-start={i.startTs}
          data-end={i.endTs}
        >
          <div class="min-w-0">
            <h3 class="text-[15px] font-semibold tracking-tight truncate" style="color: var(--ink);">{p(i.key)}</h3>
            <p class="mt-1 text-[11px] font-medium tabular-nums tracking-wide" style="color: var(--ink-soft);">
              {i.start === i.end ? i.start : `${i.start} ~ ${i.end}`}
            </p>
          </div>
          <p class="mt-auto flex items-baseline gap-1.5 pt-1">
            <span class="font-display text-[2rem] font-black leading-none tabular-nums text-gradient" data-cd-item-num>
              {Math.max(0, Math.ceil((i.startTs - now) / 86400000))}
            </span>
            <span class="text-xs font-medium" style="color: var(--ink-soft);" data-cd-item-unit>{p('cd_days')}</span>
          </p>
        </div>
      ))}
    </div>

    <p class="mt-8 text-xs leading-relaxed reveal" style="color: var(--ink-soft);">
      {p('cd_note')}
    </p>

    <aside class="mt-10 rounded-2xl border px-6 py-5 reveal" style="border-color: var(--line); background: var(--surface);">
      <p class="text-sm md:text-base font-medium leading-relaxed" style="color: var(--ink);">{p('cd_weekend_note')}</p>
    </aside>
  </section>
</Base>

<script is:inline>
  (function () {
    var locale = document.documentElement.lang || 'zh-CN';
    var labels = {
      'zh-CN': { days: '天', suffix: '天后' },
      'zh-Hant': { days: '天', suffix: '天後' },
      en: { days: 'days', suffix: 'days left' },
      ja: { days: '日', suffix: '日後' },
      ko: { days: '일', suffix: '일 후' },
      de: { days: 'Tage', suffix: 'Tage' },
      es: { days: 'días', suffix: 'días' },
      fr: { days: 'jours', suffix: 'jours' },
    };
    var L = labels[locale] || labels['zh-CN'];
    var DAY = 86400000;
    function daysUntil(ts) { return Math.ceil((ts - Date.now()) / DAY); }

    // hero 卡：EU 条例适用日倒计时
    var hero = document.querySelector('[data-cd-hero]');
    if (hero) {
      var s = +hero.dataset.start;
      var d = daysUntil(s);
      if (d > 0) hero.querySelector('[data-cd-num]').textContent = d;
    }

    // 假期卡：过去灰显、进行中标注、未来更新天数
    document.querySelectorAll('[data-cd-item]').forEach(function (el) {
      var s = +el.dataset.start, e = +el.dataset.end;
      var num = el.querySelector('[data-cd-item-num]');
      var unit = el.querySelector('[data-cd-item-unit]');
      var now = Date.now();
      if (now >= e) { el.style.opacity = '0.45'; num.textContent = '—'; unit.textContent = ''; }
      else if (now >= s) { el.style.opacity = '0.75'; num.textContent = '—'; unit.textContent = ''; }
      else { num.textContent = daysUntil(s); unit.textContent = L.suffix; }
    });
  })();
</script>
